# MongoDB (local: mongodb://127.0.0.1:27017/protege)
MONGODB_URI=

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Agent IDs, created via `npm run create-agents` (or manually in the dashboard)
# Interviewer: watches the expert, asks why at pauses, runs the debrief (Modules 1 + 2)
ELEVENLABS_INTERVIEWER_AGENT_ID=
# Tutor: coaches the new hire from the Work Map (Module 3)
ELEVENLABS_TUTOR_AGENT_ID=

# Voice mode: "real" uses ElevenLabs (burns credits), "mock" uses a text chat
# against the same prompts via the engine LLM. Use mock while building.
NEXT_PUBLIC_VOICE_MODE=mock

# Engine LLM (screen-frame vision, guardrail check, mock tutor, Work Map
# builder). Claude is the default: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model overrides (default claude-opus-5-5 for both)
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
# Fallback providers, only used when ANTHROPIC_API_KEY is empty
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
OPENAI_API_KEY=
# anthropic (default when ANTHROPIC_API_KEY is set) | gemini | openai
LLM_PROVIDER=

# Screen capture: milliseconds between frames sent to the vision model
NEXT_PUBLIC_FRAME_INTERVAL_MS=1500
# Silence (no typing, no speech, no screen change) before the agent may ask
NEXT_PUBLIC_PAUSE_MS=2500
